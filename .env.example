# PacifyIQ configuration. Copy to .env and fill in what you need.
# EVERYTHING IS OPTIONAL — the app runs fully without any of these.

# Hosted LLM (optional). Without it the local extractive backend is used.
# Get one at https://console.groq.com
PACIFYIQ_GROQ_API_KEY=

# Only needed if tesseract is installed but not on PATH (common on Windows).
# PACIFYIQ_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Model selection (defaults are fine).
# PACIFYIQ_LLM_MODEL=llama-3.3-70b-versatile
# PACIFYIQ_VISION_MODEL=llama-3.2-90b-vision-preview
