# --- secrets: never commit ---
.env
.streamlit/secrets.toml

# --- environments ---
.venv/
venv/
env/

# --- python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- runtime data (regenerated, not source) ---
data/db/traces.db
data/cache/
*.log

# --- os ---
.DS_Store
Thumbs.db

# --- notebooks: strip output before committing, keep the notebook ---
.ipynb_checkpoints/

# NOTE: data/index/ and models/ ARE committed deliberately.
# Streamlit Cloud has no build step, so the app must ship with a prebuilt
# index and classifier or it cannot start. Together they are ~8 MB, well
# inside GitHub's limits.
