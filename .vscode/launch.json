{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: PacifyIQ",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/Home.py"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Verify setup",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/verify_setup.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Full evaluation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_full_evaluation.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "console": "integratedTerminal"
    }
  ]
}
